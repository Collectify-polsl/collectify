<Window x:Class="Collectify.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Collectify.App"
        xmlns:vm="clr-namespace:Collectify.App.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Background="#F0F2F5">

        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDetailsViewVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,20,0,0">

                <!-- Create collection -->
                <Button Width="180" Height="120" Margin="10"
            BorderThickness="0" Cursor="Hand"
            Background="Transparent"
            Command="{Binding CreateCollectionCommand}">
                    <Border Background="#3B82F6" CornerRadius="8" Padding="10">
                        <TextBlock Text="Create collection"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
                    </Border>
                </Button>

                <Button Width="180" Height="120" Margin="10"
                     BorderThickness="0" Cursor="Hand"
                    Background="Transparent"
                    Command="{Binding CreateTemplateCommand}">
                    <Border Background="#10B981" CornerRadius="8" Padding="10">
                        <TextBlock Text="Create template"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
                    </Border>
                </Button>

                <Button Width="180" Height="120" Margin="10"
                    BorderThickness="0" Cursor="Hand"
                    Background="Transparent"
                    Command="{Binding EditTemplateCommand}">

                    <Border Background="#8B5CF6" CornerRadius="8" Padding="10">
                        <TextBlock Text="Edit template"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
                    </Border>
                </Button>

            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0, 160, 0, 0">
                <ItemsControl ItemsSource="{Binding Collections}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="180" Height="120" Margin="10" 
                                    BorderThickness="0" Cursor="Hand" Background="Transparent"
                                    
                                    Command="{Binding DataContext.OpenCollectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">

                                <Border Background="White" CornerRadius="8" BorderBrush="#D1D5DB" BorderThickness="1" 
                                        Width="180" Height="120">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="15">
                                        <TextBlock Text="{Binding Name}" 
                                                   FontSize="16" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="#1F2937" 
                                                   TextWrapping="Wrap" 
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="40"
                                                   Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding Description}" 
                                                   FontSize="12" 
                                                   Foreground="#6B7280" 
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="36"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid Visibility="{Binding IsDetailsViewVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">

            <local:SingleCollectionView DataContext="{Binding ActiveDetailsViewModel}"/>

        </Grid>

    </Grid>
</Window>