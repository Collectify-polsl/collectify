<Window x:Class="Collectify.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Collectify.App"
        xmlns:vm="clr-namespace:Collectify.App.ViewModels"
        mc:Ignorable="d"
        Title="Collectify" Height="600" Width="900"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDetailsViewVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,20">
                <Button Content="Create Collection"
                        Command="{Binding CreateCollectionCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="160" Height="50" Margin="10" FontSize="14"/>

                <Button Content="Create Template"
                        Command="{Binding CreateTemplateCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="160" Height="50" Margin="10" FontSize="14"/>

                <Button Content="Edit Template"
                        Command="{Binding EditTemplateCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="160" Height="50" Margin="10" FontSize="14"/>
            </StackPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding Collections}" 
                     Background="Transparent" 
                     BorderThickness="0" 
                     Padding="20"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.OpenCollectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource AppBorderBrush}"
                                    BorderThickness="1"
                                    Height="80"
                                    Padding="15"
                                    HorizontalContentAlignment="Stretch"
                                    Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" 
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"/>
                                        <TextBlock Text="{Binding Template.Name, StringFormat='Template: {0}'}" 
                                                   FontSize="12" Foreground="{StaticResource PrimaryBrush}" 
                                                   Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Description}" FontSize="14" 
                                                   Foreground="{StaticResource SubTextBrush}" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   MaxHeight="40" Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   ToolTip="{Binding Description}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="➔" VerticalAlignment="Center" 
                                               Foreground="{StaticResource SubTextBrush}" FontSize="20"
                                               Margin="15,0,0,0"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
        </Grid>

        <Grid Visibility="{Binding IsDetailsViewVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <local:SingleCollectionView DataContext="{Binding ActiveDetailsViewModel}"/>
        </Grid>

    </Grid>
</Window>