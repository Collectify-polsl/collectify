<Window x:Class="Collectify.App.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Resources/Images/icon.png"
        Title="Confirm" Height="200" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource TextBrush}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="No" IsCancel="True" Width="100" Margin="0,0,10,0" 
                    Style="{StaticResource SecondaryButtonStyle}" Click="No_Click"/>
            <Button Content="Yes" Width="100" 
                    Style="{StaticResource DangerButtonStyle}" Click="Yes_Click"/>
        </StackPanel>
    </Grid>
</Window>