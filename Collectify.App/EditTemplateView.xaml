<Window x:Class="Collectify.App.Views.EditTemplateView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Template"
        Height="520"
        Width="650"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Template selection -->
            <RowDefinition Height="Auto"/>
            <!-- Template name -->
            <RowDefinition Height="Auto"/>
            <!-- Add Field -->
            <RowDefinition Height="*"/>
            <!-- Fields List -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Template Selection -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Select Template" FontWeight="Bold"/>
            <ComboBox ItemsSource="{Binding TemplateList}"
                      SelectedItem="{Binding SelectedTemplate}"
                      DisplayMemberPath="Name"
                      Padding="5"/>
        </StackPanel>

        <!-- Template Name -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Template Name" FontWeight="Bold"/>
            <TextBox Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
        </StackPanel>

        <!-- Add Field -->
        <GroupBox Header="Add Field" Grid.Row="2" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding NewColumnName}"
                         Padding="5"/>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding DataTypeList}"
                          SelectedItem="{Binding SelectedFieldType}"
                          Margin="10,0"
                          Padding="5"/>

                <Button Grid.Column="2"
                        Content="Add"
                        Command="{Binding AddColumnCommand}"
                        Padding="15,5"/>
            </Grid>
        </GroupBox>

        <!-- Fields List -->
        <ListView Grid.Row="3" ItemsSource="{Binding Columns}" Margin="0,0,0,10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="250"
                                    DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Type" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataType}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Action" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove"
                                        Foreground="Red"
                                        Command="{Binding DataContext.RemoveColumnCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Buttons -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Delete Template"
                    Command="{Binding DeleteTemplateCommand}"
                    Background="#D32F2F"
                    Foreground="White"
                    Padding="15,5"
                    Margin="0,0,10,0"/>
            <Button Content="Save Changes"
                    Command="{Binding SaveTemplateCommand}"
                    Background="#007ACC"
                    Foreground="White"
                    Padding="15,5"/>
        </StackPanel>
    </Grid>
</Window>
