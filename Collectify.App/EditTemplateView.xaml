<Window x:Class="Collectify.App.Views.EditTemplateView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Collectify.App"
        xmlns:converters="clr-namespace:Collectify.App.Converters"
        Icon="/Resources/Images/icon.png"
        Title="Edit Template"
        Height="520"
        Width="650"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <Border Margin="0,0,0,10" Padding="10" CornerRadius="4" 
                    Visibility="{Binding StatusMessage, Converter={x:Static converters:StringToVisibilityConverter.Instance}}">
                 <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusType}" Value="Success">
                                <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusType}" Value="Error">
                                <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                 </Border.Style>
                 <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </Border>

            <TextBlock Text="Select Template" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <ComboBox ItemsSource="{Binding TemplateList}"
                  SelectedItem="{Binding SelectedTemplate}"
                  DisplayMemberPath="Name"
                  Padding="5" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="IsEnabled" Value="True"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTemplate}" Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Setter Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Template Name" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBox Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,5,0,0"/>
            </StackPanel>

            <GroupBox Header="Add Field" Grid.Row="1" Margin="0,0,0,10" BorderBrush="{StaticResource AppBorderBrush}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NewColumnName, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding DataTypeList}" SelectedItem="{Binding SelectedFieldType}" Margin="10,0" Padding="5"/>
                    <Button Grid.Column="2" Content="Add" Command="{Binding AddColumnCommand}" Padding="15,5" Style="{StaticResource SecondaryButtonStyle}"/>
                </Grid>
            </GroupBox>

            <ListView Grid.Row="2" ItemsSource="{Binding Columns}" Margin="0,0,0,10" BorderBrush="{StaticResource AppBorderBrush}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="250" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Type" Width="150" DisplayMemberBinding="{Binding DataType}"/>
                        <GridViewColumn Header="Action" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Remove" Foreground="{StaticResource DangerBrush}"
                                        Style="{StaticResource BaseButtonStyle}" Background="Transparent"
                                        Command="{Binding DataContext.RemoveColumnCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel Grid.Row="3" HorizontalAlignment="Right">
                <TextBlock FontSize="11" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,5" HorizontalAlignment="Right"
                       Text="Please add at least one field and specify a template name to save.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Hidden"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled, ElementName=SaveBtn}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button x:Name="DeleteBtn" Content="Delete Template" Command="{Binding DeleteTemplateCommand}" 
                        Style="{StaticResource DangerButtonStyle}" Margin="0,0,10,0"/>
                    <Button x:Name="SaveBtn" Content="Save Changes" Command="{Binding SaveTemplateCommand}" 
                        Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>