<Window x:Class="Collectify.App.LocalLinkPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Collectify.App.Converters"
        Icon="/Resources/Images/icon.png"
        Title="Select Item" Height="450" Width="400"
        WindowStartupLocation="CenterOwner">
    
    <Window.Resources>
        <converters:FieldValueDisplayConverter x:Key="FieldValueDisplayConverter"/>
        <converters:BytesToImageConverter x:Key="BytesToImageConverter"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Select Item from this collection:" FontWeight="SemiBold" Margin="0,0,0,10"/>
        
        <TextBox x:Name="FilterTextBox" Grid.Row="1" Margin="0,0,0,10" Padding="5" 
                 TextChanged="FilterTextBox_TextChanged"/>
        
        <ListBox x:Name="ItemsList" Grid.Row="2" Margin="0,0,0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="8">
                        <ItemsControl ItemsSource="{Binding FieldValues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{Binding FieldDefinition.Name, StringFormat='{}{0}: '}" 
                                           FontWeight="SemiBold" Foreground="#374151"/>

                                        <TextBlock Text="{Binding Converter={StaticResource FieldValueDisplayConverter}}" Foreground="#4B5563">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FieldDefinition.FieldType}" Value="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Image Source="{Binding ImageValue, Converter={StaticResource BytesToImageConverter}}" 
                                               Height="50" Stretch="Uniform" Margin="5,0,0,0">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FieldDefinition.FieldType}" Value="Image">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Clear" Click="Clear_Click" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Width="80"/>
            <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Width="80"/>
            <Button Content="Accept" Click="Select_Click" Style="{StaticResource PrimaryButtonStyle}" Width="100"/>
        </StackPanel>
    </Grid>
</Window>