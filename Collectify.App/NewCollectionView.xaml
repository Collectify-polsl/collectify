<Window x:Class="Collectify.App.NewCollectionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Collectify.App"
        xmlns:converters="clr-namespace:Collectify.App.Converters"
        Icon="/Resources/Images/icon.png"
        Title="New Collection" Height="450" Width="700" 
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <Border Margin="0,0,0,10" Padding="10" CornerRadius="4" 
                    Visibility="{Binding StatusMessage, Converter={x:Static converters:StringToVisibilityConverter.Instance}}">
                 <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
                         <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusType}" Value="Success">
                                <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                 </Border.Style>
                 <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </Border>

            <Label Content="Name:" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBox Text="{Binding CollectionName, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
            <Label Content="Description:" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBox Text="{Binding CollectionDescription}" Height="60"
                     AcceptsReturn="True" TextWrapping="Wrap" Padding="5"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,10,0,10">
            <TextBlock Text="Choose a Template" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding TemplateList}"
                      SelectedItem="{Binding SelectedTemplate}"
                      DisplayMemberPath="Name"
                      Padding="5"/>
        </StackPanel>

        <ListView Grid.Row="2" ItemsSource="{Binding DisplayedColumns}" BorderBrush="{StaticResource AppBorderBrush}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="200"/>
                    <GridViewColumn Header="Data Type" DisplayMemberBinding="{Binding DataType}" Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,15,0,0">
            <TextBlock FontSize="11" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,5" HorizontalAlignment="Right"
                       Text="Please fill in all fields."
                       Visibility="{Binding ErrorMessage, Converter={x:Static converters:StringToVisibilityConverter.Instance}}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                <Button Content="Create Collection" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>