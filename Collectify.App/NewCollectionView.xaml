<Window x:Class="Collectify.App.NewCollectionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Collectify.App"
        mc:Ignorable="d"
        Title="NewCollectionView" Height="600" Width="800">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 1. Nazwa i opis -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Tryb -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Dodaj pole / wybór szablonu -->
            <RowDefinition Height="*"/>
            <!-- 4. Wyświetlanie pól + zapis template -->
            <RowDefinition Height="Auto"/>
            <!-- 5. Zapisz kolekcję -->
        </Grid.RowDefinitions>

        <!-- 1. Nazwa i opis kolekcji -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Dane Kolekcji" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
            <Label Content="Nazwa Kolekcji:"/>
            <TextBox Text="{Binding CollectionName, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
            <Label Content="Opis:" Margin="0,5,0,0"/>
            <TextBox Text="{Binding CollectionDescription}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="5"/>
        </StackPanel>

        <!-- 2. Wybór trybu -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
            <TextBlock Text="Tryb:" FontWeight="Bold" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <ComboBox Width="200" SelectedItem="{Binding SelectedMode}" ItemsSource="{Binding Modes}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <!-- Dodawanie nowego pola (tylko w trybie własnym) -->
            <GroupBox Header="Dodaj nową kolumnę" Padding="10" Margin="0,0,0,0" BorderBrush="#007ACC"
              Visibility="{Binding IsCustomMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Text="Nazwa Pola" FontSize="11" Foreground="Gray"/>
                    <TextBlock Grid.Column="1" Text="Typ Danych" FontSize="11" Foreground="Gray" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding NewColumnName, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,5,0,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding DataTypeList}" SelectedItem="{Binding SelectedNewColumnType}" Padding="5" Margin="10,5,10,0" IsEditable="False"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="Dodaj +" Command="{Binding AddColumnCommand}" Padding="15,5" Margin="0,5,0,0" Background="#DDDDDD"/>
                </Grid>
            </GroupBox>

            

            <!-- Wybór istniejącego szablonu (tylko w trybie template) -->
            <ComboBox ItemsSource="{Binding TemplateList}" SelectedItem="{Binding SelectedTemplate}"
              Visibility="{Binding IsTemplateMode, Converter={StaticResource BoolToVisibilityConverter}}"
              Padding="5" Margin="0,5,0,0" VerticalContentAlignment="Center">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>


        <!-- 4. Wyświetlanie pól + przycisk zapisania szablonu -->
        <!-- 4. Wyświetlanie pól + przycisk zapisania szablonu -->
        <Grid Grid.Row="3" Margin="0,10,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Nazwa szablonu -->
                <RowDefinition Height="Auto"/>
                <!-- Lista pól -->
                <RowDefinition Height="Auto"/>
                <!-- Przycisk zapisu szablonu -->
            </Grid.RowDefinitions>

            <!-- Pole nazwy szablonu -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,5"
                Visibility="{Binding IsCustomMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Nazwa szablonu:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Text="{Binding NewTemplateName, UpdateSourceTrigger=PropertyChanged}" Width="200" Padding="5"/>
            </StackPanel>

            <!-- Lista pól -->
            <ListView Grid.Row="1" ItemsSource="{Binding DisplayedColumns}" BorderThickness="1" BorderBrush="#CCCCCC" Margin="0,0,0,5">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Nazwa" Width="200" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Typ" Width="150" DisplayMemberBinding="{Binding DataType}"/>
                        <GridViewColumn Header="Akcja" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Usuń" Foreground="Red" 
                                    Command="{Binding DataContext.RemoveColumnCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding DataContext.IsCustomMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Przycisk zapisu szablonu -->
            <Button Grid.Row="2" Content="Zapisz wzorzec kolekcji" Command="{Binding SaveCreatedTemplateCommand}" 
            Visibility="{Binding IsCustomMode, Converter={StaticResource BoolToVisibilityConverter}}" 
            HorizontalAlignment="Right" Margin="0,5,0,0" Width="180" Height="30"/>
        </Grid>


        <!-- 5. Zapisz kolekcję -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Utwórz kolekcję" Command="{Binding SaveCollectionCommand}" Width="180" Height="40" Background="#007ACC" Foreground="White" FontWeight="Bold" FontSize="14" Padding="15,0"/>
        </StackPanel>
    </Grid>
</Window>
