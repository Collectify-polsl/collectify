<Window x:Class="Collectify.App.NewCollectionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nowa kolekcja" Height="450" Width="700">
    
    <Window.Resources>
        <Style x:Key="CreateButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="Background" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Dane kolekcji -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Collection Data" FontSize="16" FontWeight="Bold"/>
            <Label Content="Name:" FontWeight="Bold"/>
            <TextBox Text="{Binding CollectionName}" Padding="5"/>
            <Label Content="Description:" FontWeight="Bold"/>
            <TextBox Text="{Binding CollectionDescription}" Height="60"
                     AcceptsReturn="True" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Wybór szablonu -->
        <StackPanel Grid.Row="1" Margin="0,10,0,10">
            <TextBlock Text="Choose a Template" FontWeight="Bold"/>
            <ComboBox ItemsSource="{Binding TemplateList}"
                      SelectedItem="{Binding SelectedTemplate}"
                      DisplayMemberPath="Name"
                      Padding="5"/>
        </StackPanel>

        <!-- Podgląd pól -->
        <ListView Grid.Row="2" ItemsSource="{Binding DisplayedColumns}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="200"/>
                    <GridViewColumn Header="Data Type" DisplayMemberBinding="{Binding DataType}" Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Zapis -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Margin="0,0,0,5" 
               HorizontalAlignment="Right"
               FontSize="11" 
               Foreground="DarkRed"
               Text="To create collection, set name and choose a template.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=CreateBtn}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button x:Name="CreateBtn"
            Content="Create Collection"
            Command="{Binding SaveCollectionCommand}"
            Style="{StaticResource CreateButtonStyle}"
            Height="40" 
            Width="200"/>
        </StackPanel>
    </Grid>
</Window>
