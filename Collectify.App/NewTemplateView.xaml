<Window x:Class="Collectify.App.Views.NewTemplateView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Collectify.App.Converters"
        Title="New Template"
        Height="500"
        Width="650"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Template Name" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBox Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,5,0,0"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Add a Field" Margin="0,0,0,10" BorderBrush="{StaticResource AppBorderBrush}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Row="0" Grid.Column="0"
                         Text="{Binding NewColumnName, UpdateSourceTrigger=PropertyChanged}"
                         Padding="5"
                         IsReadOnly="{Binding IsColumnNameReadOnly}"/>

                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding DataTypeList}"
                          SelectedItem="{Binding SelectedFieldType}"
                          Margin="10,0"
                          Padding="5"/>

                <Button Grid.Row="0" Grid.Column="2"
                        Content="Add"
                        Command="{Binding AddColumnCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="15,5"/>

                <CheckBox Grid.Row="1"
                          Grid.ColumnSpan="3"
                          Margin="0,10,0,0"
                          Content="Allow selecting multiple references"
                          IsChecked="{Binding AllowMultipleReferences}">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowMultipleReferenceToggle}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
            </Grid>
        </GroupBox>

        <ListView Grid.Row="2"
                  ItemsSource="{Binding Columns}"
                  Margin="0,0,0,10"
                  BorderBrush="{StaticResource AppBorderBrush}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Data Type" Width="140" DisplayMemberBinding="{Binding DataType}"/>
                    <GridViewColumn Header="Multi Ref" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsList}"
                                          HorizontalAlignment="Center">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataType}" Value="ItemReference">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Action" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove"
                                        Foreground="{StaticResource DangerBrush}"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Background="Transparent"
                                        Command="{Binding DataContext.RemoveColumnCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock FontSize="11"
                       Foreground="{StaticResource DangerBrush}"
                       Margin="0,0,0,5"
                       HorizontalAlignment="Right"
                       Text="Please fill in all fields."
                       Visibility="{Binding ErrorMessage, Converter={x:Static converters:StringToVisibilityConverter.Instance}}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                <Button Content="Create Template" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>