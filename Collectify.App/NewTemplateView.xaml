<Window x:Class="Collectify.App.Views.NewTemplateView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nowy szablon"
        Height="500"
        Width="650"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="Background" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nazwa szablonu -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Template Name" FontWeight="Bold"/>
            <TextBox Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}"
                     Padding="5"/>
        </StackPanel>

        <!-- Dodawanie kolumn -->
        <GroupBox Grid.Row="1" Header="Add a Field" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding NewColumnName, UpdateSourceTrigger=PropertyChanged}"
                         Padding="5"/>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding DataTypeList}"
                          SelectedItem="{Binding SelectedFieldType}"
                          Margin="10,0"
                          Padding="5"/>

                <Button Grid.Column="2"
                        Content="Add"
                        Command="{Binding AddColumnCommand}"
                        Padding="15,5"/>
            </Grid>
        </GroupBox>

        <!-- Lista pól -->
        <ListView Grid.Row="2"
                  ItemsSource="{Binding Columns}"
                  Margin="0,0,0,10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="250"
                                    DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Data Type" Width="150"
                                    DisplayMemberBinding="{Binding DataType}"/>
                    <GridViewColumn Header="Action" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove"
                                        Foreground="Red"
                                        Command="{Binding DataContext.RemoveColumnCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="3" HorizontalAlignment="Right">
            <TextBlock Foreground="DarkRed" 
               FontSize="11" 
               Margin="0,0,0,5" 
               HorizontalAlignment="Right"
               Text="To save the template, add at least one field and set template name.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=SaveButton}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button x:Name="SaveButton"
            Content="Save Template"
            Style="{StaticResource SaveButtonStyle}"
            Command="{Binding SaveTemplateCommand}"
            Height="40"
            Width="180"/>
        </StackPanel>
    </Grid>
</Window>
