<Window x:Class="Collectify.App.Views.NewTemplateView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nowy szablon"
        Height="500"
        Width="650"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nazwa szablonu -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Template Name" FontWeight="Bold"/>
            <TextBox Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}"
                     Padding="5"/>
        </StackPanel>

        <!-- Dodawanie kolumn -->
        <GroupBox Grid.Row="1" Header="Add a Field" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding NewColumnName, UpdateSourceTrigger=PropertyChanged}"
                         Padding="5"/>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding DataTypeList}"
                          SelectedItem="{Binding SelectedFieldType}"
                          Margin="10,0"
                          Padding="5"/>

                <Button Grid.Column="2"
                        Content="Add"
                        Command="{Binding AddColumnCommand}"
                        Padding="15,5"/>
            </Grid>
        </GroupBox>

        <!-- Lista pól -->
        <ListView Grid.Row="2"
                  ItemsSource="{Binding Columns}"
                  Margin="0,0,0,10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="250"
                                    DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Data Type" Width="150"
                                    DisplayMemberBinding="{Binding DataType}"/>
                    <GridViewColumn Header="Action" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove"
                                        Foreground="Red"
                                        Command="{Binding DataContext.RemoveColumnCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Zapis -->
        <Button Grid.Row="3"
                Content="Save Template"
                Command="{Binding SaveTemplateCommand}"
                Height="40"
                Width="180"
                HorizontalAlignment="Right"
                Background="#007ACC"
                Foreground="White"/>
    </Grid>
</Window>
