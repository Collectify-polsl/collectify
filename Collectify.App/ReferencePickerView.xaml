<Window x:Class="Collectify.App.ReferencePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wybierz przedmiot" Height="450" Width="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Choose collection.:" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <ComboBox x:Name="CollectionCombo" Grid.Row="1" Margin="0,0,0,15" 
                  SelectionChanged="CollectionCombo_SelectionChanged"/>

        <TextBlock Grid.Row="2" VerticalAlignment="Top" Text="Items:" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <ListBox x:Name="ItemsList" Grid.Row="2" Margin="0,25,0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="8">
                        <ItemsControl ItemsSource="{Binding FieldValues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{Binding FieldDefinition.Name, StringFormat='{}{0}: '}" 
                                           FontWeight="SemiBold" Foreground="#374151"/>

                                        <TextBlock Foreground="#4B5563">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding TextValue}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TextValue}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="{Binding IntValue}"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding TextValue}" Value="{x:Null}"/>
                                                                <Condition Binding="{Binding IntValue}" Value="{x:Null}"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Text" Value="{Binding DecimalValue}"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancele" IsCancel="True" Margin="0,0,10,0" Padding="15,5"/>
            <Button Content="Accept" Click="Select_Click" Padding="20,5" 
                    Background="#10B981" Foreground="White" FontWeight="Bold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>