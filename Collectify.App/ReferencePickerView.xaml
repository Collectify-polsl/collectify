<Window x:Class="Collectify.App.ReferencePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Reference" 
        Height="450" Width="400" 
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Item Link Wizard" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Foreground="#333" 
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Select Collection:" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,5" 
                       Foreground="#666"/>
            <ComboBox x:Name="CollectionCombo" 
                      Height="35"
                      VerticalContentAlignment="Center"
                      SelectionChanged="CollectionCombo_SelectionChanged" />
        </StackPanel>

        <TextBlock Grid.Row="2" 
                   Text="Select Target Item:" 
                   FontWeight="SemiBold" 
                   Margin="0,10,0,5" 
                   Foreground="#666"/>

        <Border Grid.Row="3" 
                Background="White" 
                BorderBrush="#DDD" 
                BorderThickness="1" 
                CornerRadius="3">
            <ListBox x:Name="ItemsList" 
                     BorderThickness="0" 
                     DisplayMemberPath="Name" 
                     VirtualizingStackPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Margin" Value="2,1"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E0EEF9"/>
                                <Setter Property="Foreground" Value="#007ACC"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">
            <Button Content="Cancel" 
                    IsCancel="True" 
                    Width="90" 
                    Height="32" 
                    Margin="0,0,10,0"
                    Background="White" />

            <Button Content="Link Item" 
                    Click="Select_Click" 
                    Width="110" 
                    Height="32" 
                    Background="#007ACC" 
                    Foreground="White" 
                    FontWeight="Bold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="3"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>