<Window x:Class="Collectify.App.RowWizardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dodaj Nowy Wiersz" Height="300" Width="900"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <DataTemplate x:Key="ImageCellTemplate">
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="32" Height="32" Background="#F0F0F0" CornerRadius="3" Margin="0,0,5,0">
                    <Image Source="{Binding Value}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding Value}" 
                           VerticalAlignment="Center" FontSize="10" 
                           Foreground="Gray" TextTrimming="CharacterEllipsis"/>

                <Button Grid.Column="2" Content="..." 
                        Command="{Binding DataContext.SelectImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Width="25" Margin="5,0,0,0"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ReferenceCellTemplate">
            <ComboBox ItemsSource="{Binding DataContext.AvailableReferences, RelativeSource={RelativeSource AncestorType=Window}}"
                      SelectedValue="{Binding Value}"
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="Id"
                      BorderThickness="0"
                      VerticalAlignment="Center"/>
        </DataTemplate>

        <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DefaultCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="border"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Background="White"
                                SnapsToDevicePixels="True">
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Wypełnij dane w poniższym wierszu:" FontSize="14" Margin="0,0,0,15" FontWeight="SemiBold"/>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding NewRowPreview}"
                  AutoGenerateColumns="True"
                  
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False" 
                  HeadersVisibility="Column"
                  ColumnWidth="*"
                  MinColumnWidth="150"
                  VerticalScrollBarVisibility="Auto"
                  SelectionUnit="Cell"
                  ColumnHeaderStyle="{StaticResource HeaderStyle}"
                  CellStyle="{StaticResource DefaultCellStyle}"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEEEEE">
                  <!--AutoGeneratingColumn="DataGrid_OnAutoGeneratingColumn"-->
        </DataGrid>

        <Button Grid.Row="2"
                Content="Zapisz i dodaj wiersz"
                Command="{Binding SubmitRowCommand}"
                Height="45" Margin="0,20,0,0"
                Background="#007ACC" Foreground="White" 
                FontWeight="Bold" FontSize="14">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>