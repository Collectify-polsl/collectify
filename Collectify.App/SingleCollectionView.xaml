<UserControl x:Class="Collectify.App.SingleCollectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Collectify.App"
             xmlns:converters="clr-namespace:Collectify.App.Converters"
             Background="{StaticResource AppBackgroundBrush}">

    <UserControl.Resources>
        <converters:BytesToImageConverter x:Key="BytesToImageConverter"/>

        <DataTemplate x:Key="ReferenceCellTemplate">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <TextBlock x:Name="DashText"
                           Text="-"
                           Visibility="Collapsed"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,10,0"
                           Foreground="{StaticResource DisabledForegroundBrush}"/>

                <Button x:Name="ShowIncomingBtn"
                        Width="130" Height="30"
                        HorizontalAlignment="Left"
                        Margin="5,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding DataContext.ShowReferencingItemsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}}">
                    <TextBlock Text="Show Item(s)" FontSize="11"/>
                </Button>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="-">
                    <Setter TargetName="ShowIncomingBtn" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="DashText" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="">
                    <Setter TargetName="ShowIncomingBtn" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="DashText" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ImageCellTemplate">
            <Button Command="{Binding DataContext.OpenFullImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Height="30" Width="100"
                    HorizontalAlignment="Right"
                    Margin="0,0,5,0"
                    Style="{StaticResource SecondaryButtonStyle}">
                <TextBlock Text="Show Image" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="15,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Command="{Binding ReturnCollectionsViewCommand}"
                            Margin="0,0,15,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Setter Property="Content" Value="← Back"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPopupView}" Value="True">
                                        <Setter Property="Content" Value="Quit"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <ComboBox Width="220" 
                              ItemsSource="{Binding CollectionList}" 
                              SelectedItem="{Binding SelectedCollectionItem}" 
                              DisplayMemberPath="Name"
                              VerticalContentAlignment="Center"
                              Padding="6">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPopupView}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="+ Add Item" 
                            Command="{Binding AddNewElementCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,10,0"/>

                    <Button Content="Edit Item" 
                            Command="{Binding EditItemCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,10,0"/>

                    <Button Content="Delete Item"
                            Command="{Binding DeleteItemCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            Margin="0,0,10,0"/>

                    <Button Content="Edit Info" 
                            Command="{Binding EditCollectionCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0"/>

                    <Button Content="Delete" 
                            Command="{Binding DeleteCollectionCommand}"
                            Style="{StaticResource DangerButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="15,10" Margin="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filter by:" 
                           VerticalAlignment="Center" 
                           Foreground="{StaticResource TextBrush}" 
                           FontWeight="SemiBold"
                           Margin="0,0,10,0"/>

                <ComboBox x:Name="FilterColumnComboBox"
                          Width="180" 
                          VerticalContentAlignment="Center"
                          Margin="0,0,15,0"
                          ItemsSource="{Binding AvailableColumns}"
                          SelectedItem="{Binding SelectedFilterColumn}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Value:" 
                           VerticalAlignment="Center" 
                           Foreground="{StaticResource TextBrush}" 
                           FontWeight="SemiBold"
                           Margin="0,0,10,0"/>

                <TextBox x:Name="FilterTextBox"
                         Width="250"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         BorderBrush="{StaticResource AppBorderBrush}"
                         BorderThickness="1"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <Button Content="Clear" 
                        Margin="10,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ClearFilterCommand}"/>

                <Button Content="Refresh" 
                        Margin="10,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Focusable="False"/>
            </StackPanel>
        </Border>
        
        <Border Grid.Row="2" Panel.ZIndex="1" VerticalAlignment="Top" Margin="12,0,12,0" 
                CornerRadius="4" Padding="10" 
                Visibility="{Binding StatusMessage, Converter={x:Static converters:StringToVisibilityConverter.Instance}}">
             <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusType}" Value="Success">
                            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusType}" Value="Error">
                            <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
             </Border.Style>
             <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
             <Border.Margin>
                <Thickness Left="12" Top="12" Right="12" Bottom="12"/>
             </Border.Margin>
            <DataGrid x:Name="ItemsGrid"
                      ItemsSource="{Binding DynamicTable}"
                      SelectedItem="{Binding SelectedRow}" 
                      SelectionChanged="ItemsGrid_SelectionChanged"
                      AutoGenerateColumns="False"
                      IsReadOnly="True" 
                      RowHeight="45" 
                      SelectionMode="Single"
                      EnableRowVirtualization="False" 
                      IsSynchronizedWithCurrentItem="False"
                      HeadersVisibility="Column" 
                      GridLinesVisibility="All"
                      VerticalGridLinesBrush="{StaticResource AppBackgroundBrush}"
                      HorizontalGridLinesBrush="{StaticResource AppBackgroundBrush}"
                      Background="Transparent"
                      BorderThickness="0">

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#2196F3"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

                <DataGrid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2196F3"/> <!-- Strong Blue Selection -->
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="Background" Value="#F9FAFB"/>
                        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>