<UserControl x:Class="Collectify.App.SingleCollectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Collectify.App"
             xmlns:converters="clr-namespace:Collectify.App.Converters"
             Background="#F0F2F5">

    <UserControl.Resources>
        <converters:BytesToImageConverter x:Key="BytesToImageConverter"/>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CollapsibleButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPopupView}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ReferenceCellTemplate">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="DashText" 
                           Text="-" 
                           Visibility="Collapsed" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center"
                           Foreground="#9CA3AF"/>

                <Button x:Name="RefBtn"
                        Width="30" Height="20" Background="#E0F2FE" Foreground="#0369A1" FontWeight="Bold"
                        Command="{Binding DataContext.NavigateToReferencedItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <TextBlock Text="..." HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=Content.Text}" Value="-">
                    <Setter TargetName="RefBtn" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="DashText" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=Content.Text}" Value="">
                    <Setter TargetName="RefBtn" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="DashText" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ImageCellTemplate">
            <Button Command="{Binding DataContext.OpenFullImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Height="20" Padding="8,0" FontSize="10"
                    Background="#F3F4F6" Foreground="#374151" 
                    BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="3"/>
                    </Style>
                </Button.Resources>
                <TextBlock Text="IMAGE" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1" Padding="15,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="← Back" 
                            Command="{Binding ReturnCollectionsViewCommand}"
                            Style="{StaticResource CollapsibleButtonStyle}" 
                            Background="#4B5563" Foreground="White" Margin="0,0,15,0"/>

                    <ComboBox Width="220" 
                              ItemsSource="{Binding CollectionList}" 
                              SelectedItem="{Binding SelectedCollectionItem}" 
                              DisplayMemberPath="Name"
                              VerticalContentAlignment="Center">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPopupView}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="+ Add Item" 
                            Command="{Binding AddNewElementCommand}"
                            Style="{StaticResource CollapsibleButtonStyle}" 
                            Background="#10B981" Foreground="White" Margin="0,0,10,0"/>

                    <Button Content="Delete" 
                            Command="{Binding DeleteCollectionCommand}"
                            Style="{StaticResource CollapsibleButtonStyle}" 
                            Background="#EF4444" Foreground="White"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Pasek filtrowania -->
        <Border Grid.Row="1" Background="White" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1" Padding="15,10" Margin="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filter by:" 
                           VerticalAlignment="Center" 
                           Foreground="#4B5563" 
                           FontWeight="SemiBold"
                           Margin="0,0,10,0"/>
                
                <ComboBox x:Name="FilterColumnComboBox"
                          Width="180" 
                          VerticalContentAlignment="Center"
                          Margin="0,0,15,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Value:" 
                           VerticalAlignment="Center" 
                           Foreground="#4B5563" 
                           FontWeight="SemiBold"
                           Margin="0,0,10,0"/>
                
                <TextBox x:Name="FilterTextBox"
                         Width="250"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         BorderBrush="#D1D5DB"
                         BorderThickness="1">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <Button Content="Clear" 
                        Padding="12,6"
                        Margin="10,0,0,0"
                        Background="#6B7280" 
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" Margin="12" CornerRadius="8" BorderBrush="#D1D5DB" BorderThickness="1">
            <DataGrid x:Name="ItemsGrid"
                      ItemsSource="{Binding DynamicTable}"
                      SelectedItem="{Binding SelectedRow}" 
                      SelectionChanged="ItemsGrid_SelectionChanged"
                      AutoGenerateColumns="True"
                      AutoGeneratingColumn="DataGrid_OnAutoGeneratingColumn"
                      IsReadOnly="True" 
                      RowHeight="45" 
                      SelectionMode="Single"
                      EnableRowVirtualization="False" 
                      HeadersVisibility="Column" 
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F3F4F6"
                      Background="Transparent"
                      BorderThickness="0">

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                                                            From="#FDE68A" To="#EFF6FF" 
                                                            Duration="0:0:1.5" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="Background" Value="#F9FAFB"/>
                        <Setter Property="Foreground" Value="#4B5563"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>